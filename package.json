{
  "name": "wa-personal-assistant",
  "version": "2.0.0",
  "description": "Asisten pribadi WhatsApp untuk reminder & catatan, dijalankan dari terminal, dengan pilihan AI: Claude Code CLI, Codex CLI, atau OpenAI API",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "wa-assistant": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "setup": "node src/index.js --setup",
    "logout": "node src/index.js --logout",
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "baileys": "^7.0.0-rc14",
    "chalk": "^6.0.1",
    "dotenv": "^18.0.4",
    "openai": "^7.25.0",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0"
  }
}
